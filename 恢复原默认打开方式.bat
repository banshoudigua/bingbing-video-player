@echo off
setlocal

rem ============================================================
rem  冰冰播放器 · 恢复原默认打开方式
rem
rem  双击本文件会把默认关联还原成改动之前的样子。
rem
rem  它依据的是「设为默认」时自动存下的备份文件：
rem    _默认关联备份.json（在播放器目录下）
rem  那份备份记录的是「第一次设默认之前」每个格式原本的默认程序，
rem  之后不会被覆盖，所以可以反复还原。
rem
rem  【同样要在设置页里点一下】
rem    原因跟「设为默认」一样：本机真正生效的默认关联钥匙
rem    带一套脚本算不出来的校验值，硬写会被系统做废。
rem    所以本文件还原完注册表后会自动打开设置页，
rem    你在那一项里把不想给的格式改回原程序即可。
rem
rem  【编码说明】本文件必须是 GBK / ANSI 编码 + CRLF 换行。
rem    若另存为 UTF-8 或改成 LF 换行，cmd 会因多字节解码错乱
rem    而吞掉行首字符，中文也会乱码。
rem    中文 Windows 的 cmd 默认代码页就是 936，不需要加 chcp。
rem ============================================================

cd /d "%~dp0"

set "EXE=%~dp0冰冰播放器.exe"

if not exist "%EXE%" (
    echo.
    echo [错误] 找不到主程序：
    echo        %EXE%
    echo.
    echo 可能原因：项目目录被移动或重命名了。
    echo 解决办法：把本文件放回 冰冰播放器.exe 所在目录再双击。
    echo.
    pause
    exit /b 1
)

echo 正在按备份还原默认关联...
echo
echo 稍等会弹出结果窗口，并自动打开系统的「默认应用」设置页。
echo

start "" "%EXE%" --恢复默认

exit /b 0
