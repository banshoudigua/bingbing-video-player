@echo off
setlocal

rem ============================================================
rem  冰冰播放器 · 设为默认打开方式
rem
rem  双击本文件会做两件事：
rem    1. 把「冰冰播放器」登记成 Windows 认可的默认应用条目
rem       （登记后，设置 → 默认应用 里搜「冰冰播放器」能搜到，
rem         并且有一个「设置默认值」按钮，点一次 17 种视频格式全设好）
rem    2. 打开系统的「默认应用」设置页
rem
rem  【为什么最后还要手动点一下】
rem    本机 Windows 11 25H2 实测：真正生效的那份默认关联带一套
rem    我们算不出来的校验值。第三方脚本硬写进注册表会被系统判定为篡改，
rem    反而会把那个格式的关联整个弄坏（连原本的默认程序一起丢）。
rem    所以脚本只能负责「把程序登记好、把设置页打开」，
rem    最后那一下必须由人在系统界面里完成 —— 那是 Windows 唯一承认的途径。
rem
rem  【编码说明】本文件必须是 GBK / ANSI 编码 + CRLF 换行。
rem    若另存为 UTF-8 或改成 LF 换行，cmd 会因多字节解码错乱
rem    而吞掉行首字符，中文也会乱码。
rem    中文 Windows 的 cmd 默认代码页就是 936，不需要加 chcp。
rem ============================================================

cd /d "%~dp0"

set "EXE=%~dp0冰冰播放器.exe"

if not exist "%EXE%" (
    echo.
    echo [错误] 找不到主程序：
    echo        %EXE%
    echo.
    echo 可能原因：项目目录被移动或重命名了。
    echo 解决办法：把本文件放回 冰冰播放器.exe 所在目录再双击。
    echo.
    pause
    exit /b 1
)

echo 正在登记「冰冰播放器」为默认应用...
echo
echo 稍等会弹出结果窗口，并自动打开系统的「默认应用」设置页。
echo 在设置页里搜「冰冰播放器」，点一次「设置默认值」即可全部设好。
echo

start "" "%EXE%" --设为默认

exit /b 0
